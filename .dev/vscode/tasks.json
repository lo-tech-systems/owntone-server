{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[server] autoreconf",
            "type": "shell",
            "command": "autoreconf -i",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "[server] configure",
            "type": "shell",
            "command": "./configure",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "[server] make",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "[server] scan-build",
            "type": "shell",
            "command": "make clean && scan-build --status-bugs -disable-checker deadcode.DeadStores --exclude src/parsers make",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "[server] clean",
            "type": "shell",
            "command": "make clean",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}